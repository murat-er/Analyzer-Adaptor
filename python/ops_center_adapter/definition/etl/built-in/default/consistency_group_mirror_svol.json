{
  "type": "simple",
  "etlKey": "consistency_group_mirror_svol",
  "definition": {
    "loadTargetMeasurement": "storage_consistency_group_mirror",
    "identificationType": "GLOBAL",
    "extractTargets": [
      {
        "recordName": "PD",
        "extractType": [
          "latest"
        ],
        "fields": [
          "DKC_SERIAL_NUMBER"
        ],
        "indexes": [
        ]
      },
      {
        "recordName": "PD_LDCC",
        "extractType": [
          "latest"
        ],
        "fields": [
          "CTG_ID",
          "P_VOL_DKC_SERIAL_NUMBER",
          "S_VOL_DKC_SERIAL_NUMBER",
          "P_VOL_DKC_MODEL",
          "S_VOL_DKC_MODEL",
          "MU_NUMBER",
          "M_JOURNAL_ID",
          "R_JOURNAL_ID"
        ],
        "indexes": [
          [
            "S_VOL_DKC_SERIAL_NUMBER"
          ],
          [
            "R_JOURNAL_ID"
          ]
        ]
      },
      {
        "recordName": "PI_JNLS",
        "extractType": [
          "history"
        ],
        "fields": [
          "JOURNAL_ID",
          "RIO_RESPONSE_RATE"
        ],
        "indexes": [
          [
            "JOURNAL_ID"
          ]
        ]
      }
    ],
    "transform": {
      "sql": "SELECT PI_JNLS.DATETIME, PD_LDCC_LATEST.CTG_ID, PD_LDCC_LATEST.P_VOL_DKC_SERIAL_NUMBER, PD_LDCC_LATEST.S_VOL_DKC_SERIAL_NUMBER, PD_LDCC_LATEST.P_VOL_DKC_MODEL, PD_LDCC_LATEST.S_VOL_DKC_MODEL, PD_LDCC_LATEST.MU_NUMBER, PD_LDCC_LATEST.M_JOURNAL_ID, PD_LDCC_LATEST.R_JOURNAL_ID, RIO_RESPONSE_RATE FROM PD_LDCC_LATEST JOIN PD_LATEST ON PD_LDCC_LATEST.S_VOL_DKC_SERIAL_NUMBER = PD_LATEST.DKC_SERIAL_NUMBER JOIN PI_JNLS ON PI_JNLS.JOURNAL_ID = PD_LDCC_LATEST.R_JOURNAL_ID",
      "timestampColName": "DATETIME",
      "tagKeyToColNames": [
        {
          "tagKey": "consistency_group_id",
          "queryColName": "CTG_ID"
        },
        {
          "tagKey": "pvol_storage_serial_number",
          "queryColName": "P_VOL_DKC_SERIAL_NUMBER"
        },
        {
          "tagKey": "svol_storage_serial_number",
          "queryColName": "S_VOL_DKC_SERIAL_NUMBER"
        },
        {
          "tagKey": "pvol_storage_model",
          "queryColName": "P_VOL_DKC_MODEL"
        },
        {
          "tagKey": "svol_storage_model",
          "queryColName": "S_VOL_DKC_MODEL"
        },
        {
          "tagKey": "mirror_unit_number",
          "queryColName": "MU_NUMBER"
        },
        {
          "tagKey": "master_journal_id",
          "queryColName": "M_JOURNAL_ID"
        },
        {
          "tagKey": "restore_journal_id",
          "queryColName": "R_JOURNAL_ID"
        }
      ],
      "fieldKeyToColNames": [
        {
          "fieldKey": "avg_of_restore_journal_remote_response_time_in_micro_sec",
          "queryColName": "RIO_RESPONSE_RATE"
        }
      ]
    }
  }
}
