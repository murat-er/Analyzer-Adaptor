{
  "type": "simple",
  "etlKey": "journal_master_pi_jnls",
  "definition": {
    "loadTargetMeasurement": "storage_journal_master",
    "extractTargets": [
      {
        "recordName": "PI_JNLS",
        "extractType": [
          "history"
        ],
        "fields": [
          "DATETIME",
          "JOURNAL_ID",
          "WRITE_XFER_RATE",
          "WRITE_IO_RATE",
          "ASYNC_COPY_TRANSFER_RATE"
        ],
        "indexes": [
          [
            "JOURNAL_ID"
          ]
        ]
      },
      {
        "recordName": "PD",
        "extractType": [
          "latest"
        ],
        "fields": [
          "DKC_SERIAL_NUMBER"
        ],
        "indexes": []
      },
      {
        "recordName": "PD_LDCC",
        "extractType": [
          "latest"
        ],
        "fields": [
          "P_VOL_DKC_SERIAL_NUMBER",
          "P_VOL_DKC_MODEL",
          "M_JOURNAL_ID"
        ],
        "indexes": [
          [
            "P_VOL_DKC_SERIAL_NUMBER"
          ],
          [
            "M_JOURNAL_ID"
          ]
        ]
      }
    ],
    "transform": {
      "sql": "SELECT PI_JNLS.DATETIME, PD_LDCC_LATEST.P_VOL_DKC_SERIAL_NUMBER, PD_LDCC_LATEST.P_VOL_DKC_MODEL, PD_LDCC_LATEST.M_JOURNAL_ID, PI_JNLS.WRITE_XFER_RATE, PI_JNLS.WRITE_IO_RATE, PI_JNLS.ASYNC_COPY_TRANSFER_RATE FROM PD_LDCC_LATEST JOIN PD_LATEST ON PD_LDCC_LATEST.P_VOL_DKC_SERIAL_NUMBER = PD_LATEST.DKC_SERIAL_NUMBER JOIN PI_JNLS ON PD_LDCC_LATEST.M_JOURNAL_ID = PI_JNLS.JOURNAL_ID;",
      "timestampColName": "DATETIME",
      "tagKeyToColNames": [
        {
          "tagKey": "storage_serial_number",
          "queryColName": "P_VOL_DKC_SERIAL_NUMBER"
        },
        {
          "tagKey": "storage_model",
          "queryColName": "P_VOL_DKC_MODEL"
        },
        {
          "tagKey": "journal_id",
          "queryColName": "M_JOURNAL_ID"
        }
      ],
      "fieldKeyToColNames": [
        {
          "fieldKey": "write_transfer_mebibytes_per_sec",
          "queryColName": "WRITE_XFER_RATE"
        },
        {
          "fieldKey": "write_io_per_sec",
          "queryColName": "WRITE_IO_RATE"
        },
        {
          "fieldKey": "async_copy_transfer_mebibytes_per_sec",
          "queryColName": "ASYNC_COPY_TRANSFER_RATE"
        }
      ]
    }
  }
}
