    "transform": {
      "sql": "SELECT DISTINCT PD_LDC.DATETIME, PD_LDCC_LATEST.CTG_ID, PD_LDCC_LATEST.S_VOL_LDEV_NUMBER, CLPR_NUMBER, MP_BLADE, '' AS DUMMY FROM PD_LDCC_LATEST JOIN PD_LATEST ON PD_LDCC_LATEST.S_VOL_DKC_SERIAL_NUMBER = PD_LATEST.DKC_SERIAL_NUMBER JOIN PD_LDC ON PD_LDC.LDEV_NUMBER = PD_LDCC_LATEST.S_VOL_LDEV_NUMBER WHERE PD_LDCC_LATEST.CTG_ID IS NOT NULL;",
